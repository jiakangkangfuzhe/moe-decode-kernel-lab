+def _load_a100_small_topk() -> None:
+    if hasattr(torch.ops._moe_C, "topk_softmax_a100_small"):
+        return
+    library = envs.VLLM_MOE_TOPK_LIBRARY
+    if not library:
+        raise RuntimeError(
+            "VLLM_MOE_TOPK_IMPL=a100_small requires "
+            "VLLM_MOE_TOPK_LIBRARY or a build containing the op"
+        )
+    torch.ops.load_library(library)
+    if not hasattr(torch.ops._moe_C, "topk_softmax_a100_small"):
+        raise RuntimeError(f"Top-k op was not registered by {library}")
+
+
+if envs.VLLM_MOE_TOPK_IMPL == "a100_small":
+    _load_a100_small_topk()
+
+
+def _use_a100_small_topk(
+    gating_output: torch.Tensor,
+    topk: int,
+    scoring_func: str,
+    topk_ids: torch.Tensor,
+) -> bool:
+    return (
+        envs.VLLM_MOE_TOPK_IMPL == "a100_small"
+        and scoring_func == "softmax"
+        and topk == 4
+        and gating_output.is_cuda
+        and gating_output.dtype == torch.bfloat16
+        and gating_output.is_contiguous()
+        and gating_output.dim() == 2
+        and 4 <= gating_output.size(1) <= 64
+        and 0 < gating_output.size(0) <= 64
+        and topk_ids.dtype == torch.int32
+        and torch.cuda.get_device_capability(gating_output.device) == (8, 0)
+    )
+
